# PostgreSQL connection (use your own Postgres, or your existing Supabase Postgres
# instance directly via its connection string — Project Settings > Database >
# Connection string > URI, in Supabase. Either way, this app no longer talks to
# Supabase's client SDK or auth service; it's a plain Postgres connection.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campus_mind

# Long random string — used to sign JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-value

# Comma-separated list of origins allowed to call this API (your frontend dev/prod URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: Google Gemini API key from Google AI Studio (free tier available).
# Keep this key on the backend; never add it to the frontend .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

FLASK_ENV=development
